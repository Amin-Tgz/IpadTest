# Server port
PORT=8787

# OpenAI-compatible provider
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gemini-3.7-flash

# Optional provider tuning
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_JSON_MODE=json_schema
AI_THINKING_LEVEL=low

# Development-only legacy character-analysis endpoint (0 or 1)
ENABLE_LEGACY_CHARACTER_ANALYSIS=0

# Gemini-generated Persian speech
TTS_MODEL=gemini-2.5-flash-tts
TTS_VOICE=Leda
# Keep this an English director's note: Persian instructions here make the
# voice model read the line more than once.
TTS_STYLE=Speak as a young, warm, playful original cartoon character (not an imitation of anyone), in natural Iranian Persian
