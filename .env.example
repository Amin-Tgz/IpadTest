# Server port
PORT=8787

# OpenAI-compatible provider
AI_BASE_URL=https://api.example.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gemini-3.7-flash

# Optional provider tuning
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2
AI_JSON_MODE=json_schema
AI_THINKING_LEVEL=low

# Development-only legacy character-analysis endpoint (0 or 1)
ENABLE_LEGACY_CHARACTER_ANALYSIS=0

# Gemini-generated Persian speech
TTS_MODEL=gemini-2.5-flash-tts
TTS_VOICE=Leda
TTS_STYLE=با صدایی جوان، بی‌طرف، گرم و کمی خش‌دار؛ اندکی تو دماغی، بازیگوش، طبیعی و به فارسی معیار ایران
